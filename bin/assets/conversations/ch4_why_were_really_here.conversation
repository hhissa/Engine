#conversation file
version=0.1

# Chapter 4: Why we're really here -- from "Beatsheets and scripts/
# Completed beatsheet and script.docx", the part after Chapter 3's "How does
# it feel to self harm?".
#
# Built the same way as ch3_the_cutting.conversation (see
# ch1_introductions.conversation's header for the directives). This chapter
# adds:
#   bold italic line                [title][invert] -- the script's "white
#                                   background black text"
#   "One positive point for <x>"    sets=<x>_point_1 / <x>_point_2 on that
#                                   option
#   "If all positive choices have   the persuading option's follow-ups: an
#   been made"                      `auto` branch requiring both points
#                                   (sets <x>_saved), then an unconditional
#                                   one after it -- QASystem asks the first
#                                   VISIBLE follow-up, so the second only
#                                   plays when the first is hidden
#
# Each person goes Why / Attempted / Anything to say, then on to the next.
# Their bad ending is its own top-level beat (<x>_lost), gated on a flag set
# by the two paths that lead to it rather than placed inside both -- and so
# Continue (QASystem::resume_at_first_unasked()) can't land on it for
# someone who was saved, or who hadn't reached the choice yet.
#
# Not in the script, written to fill gaps:
#   - the "<x> isn't convinced" branches: what each person says when the
#     player picks the persuading last option without both points. The
#     script only gives that option's all-points outcome.
#   - the closing quotes. The script's "Quotes:" section has Mel's and
#     names everyone else with no quote; theirs are lines from their own
#     dialogue in chapters 2-4.
#
# The number of <x>_saved flags set by the end becomes the game's title --
# see SHGame::finish_chapter() and kTitles (game_menus.cpp).
#
# Cutaways (none are red-tagged in this chapter; all suggested):
#   Mel      tall grass       cutaways/tallgrass  (meadow, dusk)
#            "began again in the morning"  cutaways/bluehour
#   Diego    the hill with no top          cutaways/hill
#            "I was so scared in there"    cutaways/hospitalbed
#            "it'll be sunny"              cutaways/beach
#   Theo     "I've already been god"       cutaways/deity
#            "Buy the cabin"               cutaways/cabin
#   Pat      "if anyone was ever talking"  cutaways/church
#            the moon, the well            cutaways/moon
#            "somebody needs to paint"     cutaways/easel
#   Alex     the phone that doesn't ring   cutaways/phone
#            "standing at one right now"   cutaways/road
#   Theresa  the two cups                  cutaways/twocups
#            "Save me a dance"             cutaways/flamenco
#            "clear blue days"             cutaways/clearday  (meadow, noon)

question "Why we're really here" {
    id=intro
    auto
    loop_to=mel_why
    answer=[P][title][invert] I want to say sorry first for misleading you
    answer=[title][invert] The purpose of this series was to get a closer look at mental illness and self-harm
    answer=[title][invert] But in truth, the people I have gathered aren't linked by a common mental illness
    answer=[title][invert] Or grouped by self-harm
    answer=[title][invert] The truth is, all these people have decided to kill themselves
    answer=[title][invert] I'll ask my trite questions, and nothing will change
    answer=[title] I have still yet to see something like this go well
}

# --- Mel -----------------------------------------------------------------

question "Mel: why do you want to die?" {
    id=mel_why
    auto
    answer=[title] Why do you want to die?
    answer=[Mel] Haha
    answer=That question sounds so strange
    answer=Nobody ever asks that question in real life
    answer=I guess I'm ashamed
    answer=The way I live is just so wrong
    answer=I need something to change
    answer=And I've tried everything else
    answer=My brain is just too atrophied to do what normal people do
    answer=Go out
    answer=Converse
    answer=Focus
    answer=It's just not there anymore
    answer=But it's okay
    answer=I will be reborn someday
    answer=I will be made a new creature
    answer=Something without this disease

    question "I was once in a place like that" {
        sets=mel_point_1
        loop_to=mel_attempt
        answer=[P] I want you to know that it doesn't have to be like that
        answer=[title][invert] What kept me alive for so long
        answer=[title][invert] Was killing me
        answer=[title][invert] You have to let go
        answer=[Mel] I don't know how to
        answer=[P][title][invert] You only have to be brave enough
        answer=[title][invert] No amount of fear will save you
        answer=[Mel] It's not that easy
    }

    question "I understand" {
        loop_to=mel_attempt
        answer=[P][title] You're right
        answer=[title] You can't recover from this
        answer=[title] Think about all the time you've already wasted
        answer=[title][invert] Don't think about all the time you have left
    }
}

question "Mel: have you ever attempted suicide?" {
    id=mel_attempt
    auto
    answer=[title] Have you ever attempted suicide?
    answer=[Mel] I've thought about it
    answer=I've thought about it a lot
    answer=Cutting myself open was different
    answer=I didn't want to die
    answer=I just wanted the thing out

    question "You must be scared" {
        loop_to=mel_say
        answer=[Mel] No, not really
        answer=You can't really be scared
        answer=[cutaway cutaways/tallgrass][overlay][stack][at 0.3 0.14][size 1.3] In the
        answer=[overlay][stack][size 1.5] end
        answer=[overlay][stack][size 1.8] the tall grass
        answer=[overlay][stack][size 2.1] claims
        answer=[overlay][stack][size 2.4] us
        answer=[overlay][stack][size 2.8] all
        answer=[P] I suppose you already have the logistics side of it down
    }

    question "There's a way out of this, you know" {
        sets=mel_point_2
        loop_to=mel_say
        answer=[Mel][title] Stop that
        answer=You promised you wouldn't try to stop us
        answer=It's why half of us signed up anyway
        answer=Just keep the questions coming
    }
}

question "Mel: is there anything you want to say?" {
    id=mel_say
    auto
    answer=[title] Is there anything you want to say?
    answer=[Mel] That I'm sorry
    answer=I wish I was better, okay?
    answer=I wish I was someone that society could embrace
    answer=That could embrace society
    answer=But in the end, I just can't
    answer=I want it known that this schizo shit is one of the worst ways biology can go wrong
    answer=There's no silver lining
    answer=It's one of the worst things that can happen to someone

    question "Listen to me" {
        answer=[P][title][invert] Self-hatred is actively antithetical to actually getting your shit together
        answer=[title][invert] I have yet to find a situation that requires it
        answer=[title][invert] If what you were doing worked, it would have worked already
        answer=[title][invert] We have to try something different
        answer=[Mel] I know
        answer=I really know
        answer=I just don't know if I can do it
        answer=[P] I understand that it's going to be difficult
        answer=But you have to press on

        question "Mel takes your words to heart" {
            auto
            requires=mel_point_1
            requires=mel_point_2
            sets=mel_saved
            loop_to=diego_why
            answer=[Mel] Do you really think I can do it?
            answer=[P][cutaway cutaways/bluehour][overlay][at 0.5 0.16][size 1.6] I know you can
            answer=[overlay][at 0.3 0.34] The world has ended for me many times
            answer=[overlay][at 0.66 0.48] And still began again in the morning
            answer=[overlay][at 0.36 0.66] If you stay here any longer
            answer=[overlay][at 0.62 0.82][size 1.4] You might miss your whole life
            answer=[title][invert] Mel takes your words to heart
            answer=[title][invert] Slowly, she gets the help she needs
            answer=[title][invert] She is now in outpatient care and trying new medication
            answer=[title][invert] She left the house earlier this week
            answer=[title][invert] The first time in months
        }

        question "Mel isn't convinced" {
            auto
            sets=mel_lost
            loop_to=mel_lost
            answer=[Mel] Press on
            answer=That's all I've been doing
            answer=Three years of pressing on, in this room
            answer=It's a nice thing to say
            answer=I just don't believe it anymore
        }
    }

    question "I hate to say it, but I understand" {
        sets=mel_lost
        loop_to=mel_lost
        answer=[Mel] A lot has happened, you know
        answer=I'm not just giving up
        answer=I really tried my hardest
        answer=I just wanted to live a good life
        answer=But now I know I can't
        answer=There's nothing I can do
    }
}

