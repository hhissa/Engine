question "How many hours of sleep do you get?" {
    id=sleep
    auto
    answer=[title] How many hours of sleep do you get?
    answer=[Mel] 14
    answer=Sometimes 16
    answer=I like sleeping through most of the day and waking up at around 2:30

    question "Why's that?" {
        loop_to=sleep_rest
        answer=[Mel] At around 4:30
        answer=[cutaway cutaways/bluehour][overlay] Still a ways from sunset
        answer=[overlay] There's an hour
        answer=[overlay] That's blue
        answer=[overlay] No one is awake at this time, not the degenerates or the early risers
        answer=[overlay] It's just me
    }

    # Still in Mel's place.
    question "Seems a bit excessive, no?" {
        loop_to=sleep_rest
        answer=[Mel] Again, that's a matter of opinion
    }
}

