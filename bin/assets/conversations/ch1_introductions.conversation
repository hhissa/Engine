#conversation file
version=0.1

# Chapter 1: Introductions -- from "Beatsheets and scripts/Chapter 1 script
# and beatsheet.docx".
#
# Every beat is an `auto` question (asked by itself, never offered as a
# choice) chained to the next with loop_to=; the player only chooses at the
# script's {options}, which are the follow-up questions of the beat they
# interrupt, each looping on to that beat's "_rest".
#
# Answer lines are script -- see games/SH/src/script_line.h:
#   [Name]            who speaks (sticky); cuts to their room, from a new
#                     camera angle each time we come back to them
#   [P]               the photographer -- never on screen, keeps the shot
#   [title]           bold line: black screen (the ding needs audio)
#   [overlay]         blue line: laid over the scene, not bottom-left
#   [cutaway <id>]    red tag: placeholder scene, marked with its id
#   [photo <path>]    cloud photos, shown instead of the room
#   [link <url>]      song recommendation; [L] opens it

question "Introductions" {
    id=intro
    auto
    loop_to=meal
    answer=[title] Let's get started
    answer=[title] Why don't you start with your name, your age, and your occupation?
    answer=[Mel] Hi, I'm Mel, I'm 23...
    answer=[P] That's awfully young.
    answer=[Mel] That's a matter of perspective.
    answer=[P] And what is it that you do?
    answer=[Mel] I'm an unemployed hikikomori
    answer=[P] A hakuku what?
    answer=[Mel] I don't leave my apartment
    answer=[Diego] Hey, I'm Diego, I'm 32, and I'm a software developer
    answer=[Theo] Yo, it's Theo, I'm 19 and I'm a college student and a dishwasher on the weekends
    answer=[P] We necessarily have younger people because the population of this series is young
    answer=But you were the only one I had objections with
    answer=You know, including you in the series
    answer=[Theo] No, I'm glad you did
    answer=I think it's important
    answer=[Pat] I'm Pat, I'm 22, and I don't really do anything since I've moved into the hospital
    answer=[Alex] Hey, I'm Alex, and I'm 27
    answer=[Theresa] Hello, I'm Theresa. I'm 76 years old, and I'm a retired secretary.
    answer=[P] So I usually find that people don't like talking about what we're gonna be talking about
    answer=Especially with strangers
    answer=So I wanna start with some icebreakers
    answer=You know, just some questions before we get into the real...
    answer=Meat and potatoes
    answer=[Theo] Bit odd to call it meat and potatoes
    answer=But go on
}

question "What is your go-to meal?" {
    id=meal
    auto
    loop_to=clouds
    answer=[title] What is your go-to meal?
    answer=[Mel] Chicken strips, rice, and Tabasco.
    answer=Pretty plain but it's what I like.
    answer=[Diego] There's a place around the corner,
    answer=Pho Pasteur, it's called
    answer=Great pho
    answer=[Theo][cutaway cutaways/ramen] Oh, let me put you on
    answer=You take an Indomie packet
    answer=Indomie is this Indonesian brand of instant noodles
    answer=Anyway, you take the Indomie and you crush it up
    answer=Add just enough water to cover the top
    answer=Leave uncovered and then add a little lime
    answer=And you've got the best noodles on the planet
    answer=[Pat] I'm not too picky
    answer=Anything but this fucking hospital food
    answer=[Alex] I'm gonna be a bit extra here
    answer=Ice cream
    answer=[Theresa] Hmm
    answer=HMMM
    answer=AH
    answer=Hot tomato soup and a nice slice of toasted sourdough bread
}

# Cloud photos show up instead of the usual scenes (photos/clouds/<name>.jpg).
question "What is your favourite type of cloud?" {
    id=clouds
    auto
    loop_to=hotdog
    answer=[title] What is your favourite type of cloud?
    answer=[Mel][photo photos/clouds/mel.jpg] You know those wispy ones really high up?
    answer=[P] Those are called cirrus clouds
    answer=They're the highest clouds and are made up of ice crystals mainly
    answer=[Mel] That's cool, I guess?
    answer=[Diego][photo photos/clouds/diego.jpg] I don't know
    answer=The fluffy ones I guess
    answer=Sorry, that's just something I don't really care about.
    answer=[Theo][photo photos/clouds/theo.jpg] Oooh, good question,
    answer=I love a big plume-y rain cloud
    answer=I love the rain in general
    answer=[Pat][photo photos/clouds/pat.jpg] I love the streaky clouds
    answer=That cover the whole sky
    answer=[Alex][photo photos/clouds/alex.jpg] I love one big grey sky
    answer=A little drizzle is perfect too
    answer=[Theresa][photo photos/clouds/theresa.jpg] I love a clear day
    answer=A perfectly blue sky
    answer=Nothing better
}

question "Would you put lettuce on a hot dog?" {
    id=hotdog
    auto
    answer=[title] Would you put lettuce on a hot dog?
    answer=[Mel] That sounds so gross.

    question "Why's that?" {
        loop_to=hotdog_rest
        answer=[Mel] I'm a pretty picky eater, so I don't really do green.
    }

    question "What do you eat then, other than chicken strips and rice?" {
        loop_to=hotdog_rest
        answer=[Mel] I literally don't eat anything else
        answer=I have it for breakfast, lunch, and dinner
        answer=Well, I only eat once per day but you get my point.
    }
}

