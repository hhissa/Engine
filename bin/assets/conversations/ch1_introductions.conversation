    answer=[Mel] What would be the point
    answer=I'd be an unemployed hikikomori anywhere in the world
    answer=[Diego] Yeah, of course, sometimes I think about moving back home

    question "Where's home?" {
        loop_to=runaway_rest
        answer=[Diego] Somewhere far away
        answer=There's a lot of nice beaches
        answer=Things are relatively cheap
        answer=It's always sunny
    }

    # The script gives the photographer no line for this option -- he
    # says nothing and Diego fills the silence.
    question "..." {
        loop_to=runaway_rest
        answer=[Diego] Well, there's a reason I live here and not there
        answer=Let's just say that
    }
}

