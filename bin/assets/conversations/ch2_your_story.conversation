#conversation file
version=0.1

# Chapter 2: Your story -- from "Beatsheets and scripts/script and
# beatsheet.docx", the part after Chapter 1's "----end of chapter----".
#
# Built the same way as ch1_introductions.conversation (see its header for
# the auto/loop_to chain and the script directives). The script's stage
# directions map onto directives:
#   bold line                       [title] card
#   blue line                       [overlay]
#   "Very large flashing text"      [overlay][fill][flash] on the next line
#   "Large text one line"           [overlay][fill] on the next line
#   "Text gets bigger every word"   [title] cards each a [size] up
#   "Each word in large text stacked one above the other revealed one at a
#   time with each enter click"     one [title][stack][size 2] card per word
#   blue lines laid out by hand     [at <x> <y>] and [size] per line, so
#                                   the words vary in place and size;
#                                   [center] for a run centred on screen
#   red tag                         [cutaway <id>]; [room] cuts back once
#                                   the blue text it was shot for ends

question "Ready for the real questions?" {
    id=ready
    auto
    loop_to=smi
    answer=[title] Okay, how are you feeling now?
    answer=[title] Ready for the real questions?
    answer=[Mel] Yeah, I feel looser
    answer=Those were good questions
    answer=[Diego] Ready as I'll ever be
    answer=[Theo] I don't see how asking a bunch of superficial questions is going to make you know me better
    answer=You should've just asked what you really wanted to ask
    answer=[Pat] I feel about the same
    answer=Still a little apprehensive
    answer=Given the subject matter
    answer=But that was fun...
    answer=Okay, I'm ready now
    answer=[Alex] Yeah, let's just get on with it
    answer=[Theresa] That was good fun
    answer=Yes, I'm ready for your questions
}

question "Can you tell me about your experiences with your disorder?" {
    id=smi
    auto
    loop_to=mel
    answer=[title] Everyone in this series suffers from a SMI
    answer=[title] That is
    answer=[title][size 1.6] Serious
    answer=[title][size 2.3] Mental
    answer=[title][size 3] Illness
    answer=[title] Can you tell me about your experiences with your disorder?
}

question "Mel" {
    id=mel
    auto
    answer=[Mel] Okay, here goes
    answer=So I'm a paranoid schizophrenic
    answer=How do I start this?
    answer=[P] Start from the beginning
    answer=[Mel] I guess I'll start when I was young then
    answer=Like 12, I sorta knew something was already off
    answer=I was a strange kid
    answer=I didn't really have all that many friends
    answer=I was really gifted though
    answer=Like, everything I did I was good at
    answer=Great at, even
    answer=Certainly the best in my grade at least
    answer=Anyway, enough showboating, I'm not like that anymore anyway
    answer=The one thing is that I would get these really violent depressive episodes
    answer=[cutaway cutaways/glowingfetalposition][overlay][at 0.28 0.12][size 1.2] It was mostly okay
    answer=[overlay][at 0.62 0.2][size 0.8] Mostly
    answer=[overlay][at 0.68 0.32] I wouldn't leave my room for days at a time
    answer=[overlay][at 0.22 0.4][size 1.6] I wouldn't eat
    answer=[overlay][at 0.75 0.47][size 0.8] It felt
    answer=[overlay][at 0.42 0.56][size 1.3] It felt like there was something inside me
    answer=[overlay][at 0.26 0.68][size 2] Weighing me down
    answer=[overlay][at 0.72 0.76][size 0.9] Sucking the life force
    answer=[overlay][at 0.55 0.84][size 2.4] out of me
    answer=[P] What did your parents think about this?
    answer=[Mel][room] Hardly noticed
    answer=I was categorised as a quiet kid
    answer=Someone who liked to be alone
    answer=[P] Do you?
    answer=I mean, like being alone
    answer=[Mel] I do, and I don't
    answer=I guess I was just alone and adjusted
    answer=I don't really know
    answer=Anyway, other than that I had a pretty easy time growing up
    answer=I never struggled academically
    answer=I had lots of friends
    answer=No one really worth mentioning other than Andy
    answer=But something was still off
    answer=It just felt off
    answer=I decided I needed to move away for university
    answer=Partly because that's what Andy wanted
    answer=I could have had a good life back home
    answer=But I wanted more
    answer=So I moved here
    answer=I started university
    answer=That's when things went
    answer=A bit awry
    answer=It started with small things
    answer=Shadows darting out the corner of my eye
    answer=I started having all these "great" ideas
    answer=I started seeing the most vivid things when I closed my eyes
    answer=Honestly, I hadn't felt better than then
    answer=It seemed like I was getting what I wanted
    answer=What I moved for
    answer=[cutaway cutaways/trippyroom] That's when I started doing a lot of drugs

    question "What kind of drugs?" {
        loop_to=mel_rest
        answer=[Mel] Anything I could get my hands on
        answer=Coke
        answer=Ket
        answer=Acid
        answer=Shrooms
        answer=Molly
        answer=Anything you can think of I would probably take
    }

    question "Why?" {
        loop_to=mel_rest
        answer=[Mel] I guess in cases like this
        answer=Whether you know it or not
        answer=Something is missing
        answer=I don't know
        answer=There's a link between schizophrenia and drug abuse
        answer=Chalk it up to that
    }
}

question "Mel (continued)" {
    id=mel_rest
    auto
    loop_to=diego
    answer=[Mel] So all of this
    answer=Plus a nasty trick of genetics
    answer=I have my first psychotic episode
    answer=[cutaway cutaways/shadowmen][overlay][at 0.25 0.15][size 1.8] The shadows
    answer=[overlay][at 0.6 0.24][size 0.8] that were darting
    answer=[overlay][at 0.78 0.34] in the corner of my
    answer=[overlay][at 0.84 0.44][size 2.4] eye
    answer=[overlay][at 0.3 0.56][size 0.9] Were now
    answer=[overlay][at 0.5 0.72][size 2.6] Fully materialized
    answer=[room] Plus a bunch of other shit
    answer=[cutaway cutaways/shadowdoorway] Like Drake
    answer=I thought he was after me
    answer=A surprisingly common hallucination, I'm told
    answer=Weird guy
    answer=I also thought I had figured out all of organized religion
    answer=Like I understood it all and that I was enlightened
    answer=As you can imagine, I wasn't doing well in school
    answer=That's when things went from awry to completely fucked
    answer=I was living in dorms at this point
    answer=My roommate hadn't seen me in a month
    answer=So naturally she came to check on me
    answer=Things got out of hand
    answer=I thought she was sent to spy on me
    answer=Things got violent
    answer=I threw a plate at her head
    answer=Okay, multiple plates, what am I lying for
    answer=Luckily none of them hit
    answer=But the girl was inconsolable
    answer=They ended up kicking me out of school
    answer=I spent a night in jail
    answer=Again, luckily the charges were dropped
    answer=Now I'm here
    answer=Living in this studio
    answer=I can't work, so I'm living off my parents
    answer=I'm really not proud of that
    answer=What I'm even less proud of is how I've spent the last 3 years
    answer=Just sitting here
    answer=Rotting
    answer=[room] All I do is sit in my room and do nothing
    answer=[P] Is that really all you do?
    answer=[Mel] I truly haven't left the house in the last three years
    answer=[cutaway cutaways/corridor] Except one 3 month stint in the hospital earlier this year
    answer=[P] Why did you end up in the hospital?
    answer=[Mel][room] I was getting to that
    answer=It was to do with my last episode
    answer=It was starting to feel like something was inside me
    answer=[overlay][fill][flash] again
    answer=This time I worked out a plan
    answer=I would make an incision
    answer=About 6 centimeters long
    answer=And pull the damn thing out
    answer=I started practicing, of course
    answer=You don't want to rush into things
    answer=I would feel out where this thing was
    answer=That was growing inside
    answer=And I would cut where it was
    answer=[title][stack][size 2] Getting
    answer=[title][stack][size 2] deeper
    answer=[title][stack][size 2] each
    answer=[title][stack][size 2] time
}

question "Diego" {
    id=diego
    auto
    loop_to=theo
    answer=[Diego] I've got this thing called treatment-resistant depression
    answer=Basically, what that means is
    answer=[overlay][fill] I'm totally fucked
    answer=I'm just kidding
    answer=What it means is traditional treatments don't work for me
    answer=I've tried a lot of SSRIs and stuff but nothing's really stuck
    answer=I guess I should start at the beginning
    answer=I had always been depressed from like a really young age
    answer=Maybe as young as 8
    answer=I didn't really realise I was depressed till I got to university
    answer=That's when I started trying different treatments
    answer=At first it was just pills
    answer=Zoloft, Lexapro, Prozac
    answer=Everything under the sun
    answer=Nothing was working
    answer=But things were okay
    answer=I was functioning and I wasn't too stressed out about anything
    answer=I was always pretty studious, so university was a breeze for me
    answer=Once I graduated, I started this job
    answer=I've been here 6 years so far
    answer=It's only slowly killing me, so that's cool
    answer=[P] Hahaha, better than a quick death?
    answer=[Diego] Anything is better than a quick death
    answer=You gotta have time to process things
    answer=Back to the story, my point was this job hasn't been great for my mental
    answer=It got to the point where I tried ECT
    answer=That worked for a bit
    answer=But not for long
    answer=I ended up in the hospital
    answer=[overlay][fill][flash] Again
    answer=[cutaway cutaways/hospitalbed] I was catatonic for a period of time
    answer=I don't know if you've ever had a catheter inserted
    answer=But that is not fun
    answer=[room] I got out of the hospital
    answer=Even got a promotion
    answer=But honestly that just made it worse
    answer=The only thing that really made it any easier
    answer=I discovered about 4, maybe 5 years ago
    answer=I was cooking
    answer=I was slicing an onion and accidentally chopped through it into my palm
    answer=That's when I started cutting
}

question "Theo" {
    id=theo
    auto
    loop_to=pat
    answer=[Theo] I'm bipolar
    answer=More specifically, I'm bipolar type 1 with psychotic symptoms
    answer=That means I have periods, sometimes months long
    answer=[overlay][at 0.2 0.85][size 1.4] Of really low lows
    answer=[overlay][at 0.78 0.14][size 1.8] and really high highs
    answer=Those are called depression and mania
    answer=My mania is a little different
    answer=I have serious delusions
    answer=And paranoia
    answer=And I see things and hear things
    answer=Things were always kinda weird growing up
    answer=I was perfectly happy
    answer=Just odd
    answer=Don't get me wrong, I had periods when I was absolutely killing it
    answer=School was a breeze for me
    answer=I guess I kinda got depressed sometimes,
    answer=but not really anything worth mentioning
    answer=Then I moved out and went to school
    answer=I was 18
    answer=I also started smoking a bunch of weed, which didn't help things
    answer=I had just started making friends too
    answer=And then I just lost it
    answer=I thought I had super powers
    answer=[P] What kind of super powers?
    answer=[Theo] I thought I could read people's minds
    answer=[cutaway cutaways/deity] I thought I was an immortal deity
    answer=A lot of other stupid shit like that
    answer=[room] But if anything, all that kept my confidence up, you know
    answer=When you feel like god you start acting, all things considered, pretty good
    answer=You just have to keep your thoughts to yourself
    answer=It gets harder once you start feeling the paranoia
    answer=Once you start hearing things, shit really hits the fan
    answer=At a certain point the only thing you can do is ask for help
    answer=But how could I? I didn't trust any of my friends
    answer=I couldn't tell my family
    answer=Eventually I went to the university clinic and they made me an appointment with a psych
    answer=I had to wait a few months but I was getting help
    answer=Then I missed the appointment and totally broke down
    answer=So I just had to wait the episode out
    answer=Eventually I told my family and got the help I needed
    answer=That brings us to this year
    answer=I'm back in school
    answer=But fuck me, am I depressed
    answer=I've been cutting recently
    answer=That's when I reached out to you
}

